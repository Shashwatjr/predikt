# Local Nest API (or a cloudflared tunnel URL during device testing).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional web Maps Embed key (referrer-restricted). Server Places/Directions
# keys live only in backend/.env as GOOGLE_MAPS_API_KEY — see docs/GOOGLE_MAPS_SETUP.md.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_OLA_MAPS_API_KEY=
