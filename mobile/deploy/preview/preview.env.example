# Build and runtime must use the same dedicated non-production preview origin.
PREVIEW_WEB_ORIGIN=https://phase1-preview.example.test
# Fixed isolated backend; production origins are rejected by server.mjs.
PREVIEW_API_ORIGIN=https://phase1-api.example.test
PORT=8080
PREVIEW_BIND_HOST=127.0.0.1
# Backend environment, configured separately (never commit secrets):
# NODE_ENV=staging
# CORS_ORIGINS=https://phase1-preview.example.test
# WEB_BASE_URL=https://phase1-preview.example.test
# DATABASE_URL=<isolated reconciled TEST database only>
# JWT_SECRET=<independent preview secret>
# ADMIN_JWT_SECRET=<independent preview admin secret>
